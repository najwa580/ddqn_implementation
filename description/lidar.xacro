<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- FIXED JOINT TO ROBOT -->
    <joint name="lidar_base_joint" type="fixed">
        <parent link="chassis"/>
        <child link="base"/>
        <origin xyz="0.2 0 0.18" rpy="0 0 0"/>
    </joint>

    <!-- BASE -->
    <link name="base">
        <visual>
            <geometry>
                <cylinder radius="0.04267" length="0.05867"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.04267" length="0.05867"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="1.2" length="0.05867" radius="0.04267">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="base">
        <material>Gazebo/Red</material>
    </gazebo>

    <!-- TOP -->
    <joint name="laser_joint" type="fixed">
        <parent link="base"/>
        <child link="top"/>
        <origin xyz="0 0 0.067" rpy="0 0 0"/>
    </joint>

    <link name="top">
        <visual>
            <geometry>
                <cylinder radius="0.04267" length="0.07357"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.04267" length="0.07357"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.07357" radius="0.04267">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- GAZEBO SENSOR -->
    <gazebo reference="top">

        <sensor type="ray" name="lidar_2d">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>

            <ray>
                <scan>
                    <!-- 2D LIDAR -->
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>

                    <!-- IMPORTANT: 2D = 1 SEUL LAYER -->
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>0.0</max_angle>
                    </vertical>
                </scan>

                <range>
                    <min>0.12</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>

            <!-- PLUGIN ROS2 -->
            <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <!-- IMPORTANT -->
                    <remapping>~/out:=scan</remapping>
                </ros>

                <!-- TYPE CORRECT -->
                <output_type>sensor_msgs/LaserScan</output_type>

                <frame_name>top</frame_name>
            </plugin>

        </sensor>
    </gazebo>

</robot>
